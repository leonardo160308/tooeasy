🛠️ Tecnologías Utilizadas
Node.js

Express

MySQL

JavaScript

HTML5 / CSS3

Fetch API

JWT (Autenticación)

📚 Funcionalidades Principales
Registro e inicio de sesión de usuarios

Sistema de niveles educativos

Flashcards por nivel

Quizzes interactivos

Progreso del usuario

Sistema de monedas y recompensas

Desbloqueo de skins (casas y castores)

Dashboard financiero

Control de ingresos y egresos

Protección de rutas

Roles de usuario (admin / user)

🗄️ Base de Datos (MySQL)
El proyecto utiliza MySQL como sistema gestor de base de datos.

📄 Script de creación de la base de datos
Ejecutar el siguiente script completo en MySQL:

sql
Copiar código
CREATE DATABASE IF NOT EXISTS tooeasy CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
USE tooeasy;

/* ===============================
   TABLAS PRINCIPALES
   =============================== */

CREATE TABLE skins (
  id VARCHAR(100) PRIMARY KEY,
  tipo ENUM('house','beaver') NOT NULL,
  nombre VARCHAR(150) NOT NULL,
  imagen VARCHAR(512) NOT NULL,
  unlock_level TINYINT UNSIGNED DEFAULT 0
) ENGINE=InnoDB;

CREATE TABLE levels (
  id TINYINT UNSIGNED PRIMARY KEY,
  nombre VARCHAR(100),
  preguntas_count TINYINT UNSIGNED DEFAULT 5,
  reward_coins INT UNSIGNED DEFAULT 20
) ENGINE=InnoDB;

CREATE TABLE users (
  id BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL UNIQUE,
  email VARCHAR(255) UNIQUE NOT NULL,
  password_hash VARCHAR(255),
  edad TINYINT UNSIGNED,
  genero VARCHAR(20),
  foto VARCHAR(512),
  coins INT UNSIGNED DEFAULT 0,
  dashboard_balance DECIMAL(12,2) DEFAULT 0.00,
  wood INT UNSIGNED DEFAULT 0,
  level TINYINT UNSIGNED DEFAULT 1,
  house_level TINYINT UNSIGNED DEFAULT 1,
  beaver_level TINYINT UNSIGNED DEFAULT 1,
  current_appearance VARCHAR(100) DEFAULT 'skin_default',
  current_beaver VARCHAR(100) DEFAULT 'castor_default',
  role ENUM('admin','user') NOT NULL DEFAULT 'user',
  is_active BOOLEAN DEFAULT TRUE,
  avatar VARCHAR(100),
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
) ENGINE=InnoDB;

/* ===============================
   SISTEMA EDUCATIVO
   =============================== */

CREATE TABLE learning_categories (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL UNIQUE,
  descripcion TEXT,
  orden INT NOT NULL,
  nivel_inicio INT NOT NULL,
  nivel_fin INT NOT NULL
);

CREATE TABLE educational_levels (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nombre VARCHAR(100) NOT NULL,
  descripcion TEXT,
  orden INT NOT NULL,
  category_id INT,
  FOREIGN KEY (category_id) REFERENCES learning_categories(id)
);

CREATE TABLE flashcards (
  id INT AUTO_INCREMENT PRIMARY KEY,
  level_id INT NOT NULL,
  titulo VARCHAR(200) NOT NULL,
  contenido TEXT NOT NULL,
  imagen VARCHAR(255),
  orden INT NOT NULL,
  FOREIGN KEY (level_id) REFERENCES educational_levels(id)
);

CREATE TABLE quiz_questions (
  id INT AUTO_INCREMENT PRIMARY KEY,
  level_id INT NOT NULL,
  pregunta TEXT NOT NULL,
  opciones JSON NOT NULL,
  correcta CHAR(1) NOT NULL,
  dificultad ENUM('facil','media','dificil') DEFAULT 'media',
  imagen VARCHAR(255),
  FOREIGN KEY (level_id) REFERENCES educational_levels(id)
);

/* ===============================
   USUARIO ADMIN
   =============================== */

INSERT INTO users (nombre, email, password_hash, edad, genero, role)
VALUES ('admin', 'admin@tooeasy.com', 'admin123', 30, 'otro', 'admin')
ON DUPLICATE KEY UPDATE role = 'admin';